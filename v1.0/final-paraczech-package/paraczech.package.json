            "constraints": {
              "required": true,
              "unique": true,
              "pattern": "(cmpg|sprg|pass|anim|posp|actv|negp|pstg|inan|acc|inf|pst|dat|fut|gen|voc|ins|prs|loc|imp|nom|pl|sg|du|m|f|n|1|3|2)(\\.(cmpg|sprg|pass|anim|posp|actv|negp|pstg|inan|acc|inf|pst|dat|fut|gen|voc|ins|prs|loc|imp|nom|pl|sg|du|m|f|n|1|3|2))*"
